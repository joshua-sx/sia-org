      {
        "name": "list_people",
        "title": "List people",
        "description": "List employee records in the signed-in user's organization, including job title, org unit, and reporting line.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
