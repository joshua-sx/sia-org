          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_appraisal_history",
        "title": "Get appraisal history",
        "description": "Return completed-cycle appraisal records. Employees see their own history; managers see direct reports; HR sees org-wide history.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
